# ─────────────────────────────────────────────────────────────
# issue-stream 환경 설정
# 이 파일을 .env 로 복사해서 사용. .env 는 git에 올리지 않는다.
# ─────────────────────────────────────────────────────────────

# ── DB ───────────────────────────────────────────────────────
# 비워두면 프로젝트 폴더의 SQLite 파일(data/issue_stream.db)을 쓴다. 설치·Docker 불필요.
# PostgreSQL 을 쓰려면: pip install -e ".[postgres]" 후
#   DATABASE_URL=postgresql+psycopg://issue:issue@localhost:5432/issue_stream
DATABASE_URL=

# ── 유료 API 안전장치 ────────────────────────────────────────
# false 이면 아래 provider를 유료로 설정해도 실행 시 오류로 막는다.
# 유료 기능을 켤 때는 이 값을 true로 바꾸고 해당 키를 채운다. (docs/PAID_UPGRADES.md)
ALLOW_PAID_APIS=false

# ── 교체형 구성요소 (provider) ───────────────────────────────
# 임베딩:  hashing(무료, 설치 불필요, 기본) | local(무료, 다국어 모델, pip install -e .[ml]) | openai(유료)
#   hashing 과 local(e5-small) 은 둘 다 384차원 → 전환 시 DB 변경 없이 재임베딩만 하면 된다.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# 모델을 바꾸면 차원이 바뀐다 → docs/PAID_UPGRADES.md 의 "임베딩 교체" 절차 참고
EMBEDDING_DIM=384

# 이슈 요약: extractive(무료, LLM 없음, 기본) | ollama(무료, 로컬 LLM) | anthropic(유료)
SUMMARIZER_PROVIDER=extractive
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
ANTHROPIC_MODEL=claude-haiku-4-5

# 감성 분류: lexicon(무료, 규칙 기반, 기본) | hf_local(무료, KR-FinBert-SC) | summarizer(요약 결과 사용)
SENTIMENT_PROVIDER=lexicon

# ── 무료 API 키 ──────────────────────────────────────────────
DART_API_KEY=
ECOS_API_KEY=
FRED_API_KEY=
KOSIS_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 한국투자증권 (증권계좌 필요, 무료). 비워두면 pykrx 일봉으로 대체.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_TYPE=paper   # paper(모의) | real

# ── 유료 API 키 (ALLOW_PAID_APIS=true 일 때만 사용) ──────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── 알림 (무료, 선택) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_IMPORTANCE_THRESHOLD=70

# ── 파이프라인 파라미터 ──────────────────────────────────────
# 비워두면 임베딩별 기본값(hashing 0.35 / local 0.86 / openai 0.60). `issue-stream tune-threshold` 로 조정
CLUSTER_SIM_THRESHOLD=
CLUSTER_WINDOW_HOURS=48
DEDUPE_HAMMING_THRESHOLD=3
RESUMMARIZE_GROWTH_RATIO=0.3

# 저작권: 기사 본문은 기본적으로 가져오지 않는다 (RSS 제목·요약문만 사용)
FETCH_ARTICLE_BODY=false
# 본문을 가져오더라도 이 시간이 지나면 삭제
ARTICLE_BODY_TTL_HOURS=24
# 원본 기사 메타데이터 보존 기간
ARTICLE_RETENTION_DAYS=180

# ── 로그인·가입 ──────────────────────────────────────────────
# 로그인 유지 기간(일)
SESSION_DAYS=30
# 가입 화면(/signup). false 면 닫고 `issue-stream user add <아이디>` 로만 계정을 만든다
SIGNUP_ENABLED=true
# 값을 넣으면 이 초대 코드를 아는 사람만 가입할 수 있다 (비우면 누구나)
SIGNUP_INVITE_CODE=
# 계정별 관심종목 상한. 관심종목이 늘수록 뉴스 검색·시세 수집 요청이 늘어난다
MAX_WATCHLIST_PER_USER=50

LOG_LEVEL=INFO
TZ=Asia/Seoul
